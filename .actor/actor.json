{
  "actorSpecification": 1,
  "name": "coingecko-crypto-scraper",
  "title": "CoinGecko Crypto Scraper - Prices & Market Data",
  "description": "Fetch structured CoinGecko market data: price, market cap, rank, volume, 24h change, supply, ATH/ATL, and source links. Search by coin ID/name or top market cap; BYO API key for production use.",
  "version": "1.0",
  "categories": ["BUSINESS", "DEVELOPER_TOOLS", "OTHER"],
  "dockerfile": "Dockerfile",
  "input": "../INPUT_SCHEMA.json",
  "readme": "../README.md",
  "output": "./output_schema.json",
  "exampleRunInput": {
    "body": "{\"coinIds\":[\"bitcoin\"],\"searchQueries\":[],\"maxSearchResults\":2,\"topCoins\":0,\"vsCurrency\":\"usd\",\"apiAccess\":\"keyless\",\"apiKey\":\"\",\"proxyConfiguration\":{\"useApifyProxy\":false}}",
    "contentType": "application/json; charset=utf-8"
  },
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "coins": {
          "title": "Coins",
          "transformation": {
            "fields": ["imageUrl", "marketCapRank", "id", "name", "symbol", "currentPrice", "vsCurrency", "marketCap", "totalVolume", "priceChangePercentage24h", "high24h", "low24h", "circulatingSupply", "maxSupply", "ath", "athDate", "atl", "lastUpdated", "coinGeckoUrl", "attribution", "scrapedAt"]
          },
          "display": {
            "component": "table",
            "properties": {
              "imageUrl": { "label": "Image", "format": "image" },
              "marketCapRank": { "label": "Rank", "format": "number" },
              "id": { "label": "Coin ID", "format": "text" },
              "name": { "label": "Name", "format": "text" },
              "symbol": { "label": "Symbol", "format": "text" },
              "currentPrice": { "label": "Price", "format": "number" },
              "vsCurrency": { "label": "Currency", "format": "text" },
              "marketCap": { "label": "Market Cap", "format": "number" },
              "totalVolume": { "label": "Volume 24h", "format": "number" },
              "priceChangePercentage24h": { "label": "Change 24h %", "format": "number" },
              "high24h": { "label": "High 24h", "format": "number" },
              "low24h": { "label": "Low 24h", "format": "number" },
              "circulatingSupply": { "label": "Circulating", "format": "number" },
              "maxSupply": { "label": "Max Supply", "format": "number" },
              "ath": { "label": "ATH", "format": "number" },
              "athDate": { "label": "ATH Date", "format": "date" },
              "atl": { "label": "ATL", "format": "number" },
              "lastUpdated": { "label": "Last Updated", "format": "date" },
              "coinGeckoUrl": { "label": "CoinGecko URL", "format": "link" },
              "attribution": { "label": "Attribution", "format": "text" },
              "scrapedAt": { "label": "Scraped At", "format": "text" }
            }
          }
        }
      }
    }
  },
  "pricingInfo": {
    "pricingModel": "PAY_PER_EVENT",
    "pricingPerEvent": {
      "actorChargeEvents": {
        "apify-actor-start": {
          "eventTitle": "Actor Start",
          "eventDescription": "Charged when the Actor starts running. Number of events charged depends on Actor memory (one event per GB, minimum one event).",
          "isOneTimeEvent": true,
          "eventPriceUsd": 0.00005
        },
        "coin-scraped": {
          "eventTitle": "Coin Scraped",
          "eventDescription": "Charged for each cryptocurrency's market data extracted and saved to the dataset.",
          "isOneTimeEvent": false,
          "isPrimaryEvent": true,
          "eventPriceUsd": 0.001
        }
      }
    }
  },
  "defaultRunOptions": {
    "build": "latest",
    "memoryMbytes": 512,
    "timeoutSecs": 3600
  },
  "minMemoryMbytes": 256,
  "maxMemoryMbytes": 2048
}
